GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
DEMO_PASSWORD=
# DEMO_PASSWORD is the owner password for re-indexing; visitors add repos and ask without it
DEMO_REPO_URL=https://github.com/fastapi/full-stack-fastapi-template

# Optional tuning (defaults shown)
# MAX_REPO_SIZE_MB=200
# INDEX_PER_VISITOR_PER_DAY=5
# ASK_PER_VISITOR_PER_DAY=30
# REPO_TTL_HOURS=24
# MAX_VISITOR_REPOS=15
# ASK_RATE_LIMIT_PER_MINUTE=10
# ASK_DAILY_LIMIT=0
# LLM_CACHE=false
# TRUST_PROXY=false
# GITHUB_TOKEN=
# RETRIEVAL_MODE=vector
# RERANK=false
# MIN_VECTOR_SCORE=0.60
# LOG_LEVEL=INFO

# Repository overview built at index time (LLM summaries, capped per repo)
# OVERVIEW=true
# OVERVIEW_MAX_FILES=60
# OVERVIEW_MAX_FOLDERS=25
# OVERVIEW_BATCH_SIZE=20
# OVERVIEW_MAX_CALLS=5
# OVERVIEW_FILE_CHARS=1200
# OVERVIEW_K=3

# Question routing: tool / overview / code (rules first, LLM only when the rules are unsure)
# ROUTING=true
# ROUTING_LLM=true
# FOLLOWUP_REWRITE=true

# Query expansion (measured: better Hit@1, worse Hit@5 and citations; off by default)
# QUERY_EXPANSION=false
# EXPANSION_VARIANTS=3
# EXPANSION_ORIGINAL_WEIGHT=4
# EXPANSION_SKIP_ABOVE=0

# Extra context for the LLM: enclosing class/section of retrieved chunks, and definitions of called functions
# PARENT_CONTEXT=false
# PARENT_MAX_LINES=100
# PARENT_WINDOW=10
# CALL_CONTEXT=true
# CALL_MAX_FUNCTIONS=4
# CALL_MAX_LINES=150
# SUGGESTED_QUESTIONS=true

# Index hygiene: skip data files, down-weight generated code, fixtures, migrations and tests at query time
# HYGIENE=true
# DOWNWEIGHT_FACTOR=0.9
# DOWNWEIGHT_TESTS=true
# MAX_JSON_KB=50
# Extra fnmatch patterns (JSON lists), matched against "/<path>"; * also matches /
# HYGIENE_EXTRA_SKIP=["*/vendor_data/*"]
# HYGIENE_EXTRA_DOWNWEIGHT=["*/legacy/*"]
